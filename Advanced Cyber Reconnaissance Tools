        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            event.target.classList.add('active');
        }

        function showWorkflow(workflowId, btnElement) {
            document.querySelectorAll('.workflow-section').forEach(wf => wf.style.display = 'none');
            document.querySelectorAll('.select-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(workflowId).style.display = 'flex';
            btnElement.classList.add('active');
        }

        function openUrl(templateUrl) {
            let target = document.getElementById('targetInput').value.trim();
            if(!target && templateUrl.includes('{target}')) {
                alert('אנא הזן מטרה (Target) בתיבה העליונה לפני השימוש בכלי זה.');
                return;
            }
            let finalUrl = templateUrl.replace(/{target}/g, encodeURIComponent(target));
            window.open(finalUrl, '_blank');
        }

        function filterCommands() {
            let osFilter = document.getElementById('cliOsSelect').value;
            let query = document.getElementById('cliQuery').value.toLowerCase().trim();
            let target = document.getElementById('targetInput').value.trim() || "example.com";
            
            let container = document.getElementById('cliResults');
            container.innerHTML = '';

            let filtered = cliCommands.filter(item => {
                let matchesOs = (osFilter === 'all' || item.os === osFilter);
                let matchesQuery = !query || 
                                   item.title.toLowerCase().includes(query) || 
                                   item.tags.toLowerCase().includes(query) || 
                                   item.cmd.toLowerCase().includes(query) ||
                                   (item.flags && item.flags.some(f => f.flag.toLowerCase().includes(query) || f.desc.toLowerCase().includes(query)));
                return matchesOs && matchesQuery;
            });

            if(filtered.length === 0) {
                container.innerHTML = '<p style="color: var(--text-muted);">לא נמצאו פקודות מתאימות לחיפוש שלך.</p>';
                return;
            }

            filtered.forEach(item => {
                let cmdFormatted = item.cmd.replace(/{target}/g, target);
                
                let flagsHtml = '';
                if(item.flags && item.flags.length > 0) {
                    let flagsListItems = item.flags.map(f => `
                        <li class="cmd-flag-item">
                            <span class="cmd-flag-code">${f.flag}</span>
                            <span>${f.desc}</span>
                        </li>
                    `).join('');

                    flagsHtml = `
                        <div class="cmd-flags-container">
                            <div class="cmd-flags-title">📌 פלאגים ופרמטרים אפשריים:</div>
                            <ul class="cmd-flags-list">
                                ${flagsListItems}
                            </ul>
                        </div>
                    `;
                }

                let card = document.createElement('div');
                card.className = 'cmd-item';
                card.innerHTML = `
                    <div class="cmd-header">
                        <span class="cmd-title">${item.title}</span>
                        <span class="cmd-os-tag">${item.os.toUpperCase()}</span>
                    </div>
                    <div class="cmd-code-block">
                        <code>${cmdFormatted}</code>
                        <button class="copy-cmd-btn" onclick="copyToClipboard('${cmdFormatted.replace(/'/g, "\\'")}')">📋 העתק</button>
                    </div>
                    ${flagsHtml}
                `;
                container.appendChild(card);
            });
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text);
            alert('הפקודה הועתקה ללוח!');
        }

        window.onload = function() {
            let savedNotes = localStorage.getItem('osintNotes');
            if(savedNotes) { document.getElementById('osintNotes').value = savedNotes; }
            document.querySelector('.select-btn').click();
            filterCommands();
        }

        function saveNotes() {
            let notes = document.getElementById('osintNotes').value;
            localStorage.setItem('osintNotes', notes);
            let indicator = document.getElementById('saveIndicator');
            indicator.style.opacity = 1;
            setTimeout(() => { indicator.style.opacity = 0; }, 2000);
        }
    </script>
</body>
